# copiado para .env no setup local — nunca commitar o .env real
DATABASE_URL=postgresql://user:password@localhost:5432/lista_de_tarefas
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-bem-longa
BETTER_AUTH_URL=http://localhost:3000

# opcional: origens extras separadas por vírgula
TRUSTED_ORIGINS=

# opcional: usuário inicial via `npx prisma db seed` (senha com 12+ caracteres)
SEED_EMAIL=
SEED_NAME=
SEED_PASSWORD=

# opcional: login social com Google (Google Cloud Console → APIs e serviços → Credenciais)
# URIs de redirecionamento autorizados: http://localhost:3000/api/auth/callback/google
# (e em produção: https://seu-dominio.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
